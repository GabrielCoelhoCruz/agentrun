{
  "name": "agentrun",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "bin": {
    "agentrun": "./dist/bin.mjs"
  },
  "files": [
    "dist",
    "demo.gif"
  ],
  "scripts": {
    "build": "tsdown src/index.ts src/bin.ts src/worker.ts --format esm --dts",
    "build:test": "tsdown test/fixtures/entry.ts test/fixtures/fake-worker.ts --format esm --out-dir test/fixtures/dist"
  },
  "dependencies": {
    "@agentrun/core": "workspace:*",
    "@effect/platform-node": "^4.0.0",
    "effect": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.1"
  },
  "description": "Run Claude Code and Pi tasks in isolated Git worktrees",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GabrielCoelhoCruz/agentrun.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/GabrielCoelhoCruz/agentrun/issues"
  },
  "homepage": "https://github.com/GabrielCoelhoCruz/agentrun#readme",
  "publishConfig": {
    "access": "public"
  },
  "os": [
    "darwin",
    "linux"
  ]
}
